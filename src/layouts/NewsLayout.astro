---
import BaseLayout from './BaseLayout.astro';
import { url } from '../lib/url';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { categories } from '../data/categories';

interface Props {
  title: string;
  summary: string;
  date: Date;
  tag: string;
  metaTitle?: string;
  metaDescription?: string;
  source: { name: string; url: string };
  related?: Array<{ title: string; category: string; slug: string; description?: string }>;
}

const { title, summary, date, tag, metaTitle, metaDescription, source, related = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Map a display category ("Frameworks", "Case Studies", ...) to its URL segment.
const categorySegment = (c: string) => {
  const k = c.toLowerCase();
  if (k === 'case studies' || k === 'case-studies') return 'case-studies';
  return k; // concepts | instruments | actors | frameworks
};

const relatedWithHrefs = related.map(a => ({
  title: a.title,
  category: a.category,
  description: a.description || `Read the ${a.title} explainer.`,
  href: url(`/${categorySegment(a.category)}/${a.slug}/`)
}));
---
<BaseLayout
  title={`${metaTitle || title} | Climate Finance Wiki`}
  description={metaDescription || summary}
  footerType="internal"
  activePage="news"
  schemaType="Article"
  publishDate={date.toISOString()}
>
  <Breadcrumbs items={[
    { label: 'Home', href: url('/') },
    { label: 'News', href: url('/news/') },
    { label: title }
  ]} />
  <section class="page-head pad" aria-labelledby="page-h">
    <p class="tag"><span class="num">{tag}</span>&ensp;&middot;&ensp;{formattedDate}</p>
    <h1 id="page-h">{title}</h1>
    <p class="standfirst">{summary}</p>
    <p class="byline">By <a href={url('/author/ibukun-taiwo/')}>Ibukun Taiwo</a></p>
  </section>

  <div class="article-layout pad">
    <article>
      <div class="news-body reveal">
        <slot />
      </div>

      <div class="src-box reveal">
        <span class="tag">Original source &mdash; full credit to the reporting outlet</span>
        <a class="src-link" href={source.url} target="_blank" rel="noopener nofollow">
          Read the full story at {source.name} <span class="arr">&rarr;</span>
        </a>
      </div>

      {relatedWithHrefs.length > 0 && (
        <div class="related reveal">
          <span class="tag"><span class="num">Related</span>&ensp;on the Wiki</span>
          <ul class="rel-list">
            {relatedWithHrefs.map((a) => (
              <li>
                <a class="rel-row" href={a.href}>
                  <span class="rel-cat">{a.category}</span>
                  <span><span class="rel-title">{a.title}</span><span class="rel-desc">{a.description}</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="curated reveal">Curated {formattedDate}&ensp;&middot;&ensp;Climate Finance Wiki</p>
    </article>

    <aside class="side">
      <div class="side-sticky">
        <div class="side-block">
          <a class="back-link" href={url('/news/')}><span class="arr">&larr;</span> All news</a>
        </div>
        <div class="side-block">
          <span class="tag">Stay Updated</span>
          <p class="side-text">Follow new climate-finance dispatches and explainers through the RSS feed.</p>
          <a class="rss-link" href={url('/rss.xml')}>Subscribe via RSS <span class="arr">&rarr;</span></a>
        </div>
        <div class="side-block">
          <span class="tag">Browse the Wiki</span>
          <ul class="b-list">
            {categories.map((cat) => (
              <li>
                <a class="b-row" href={url(`/${cat.slug}/`)}>
                  <span class="b-name">{cat.name}</span>
                  <span class="b-count">{cat.articleCount}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </aside>
  </div>

  <style>
    /* ---------- article head ---------- */
    .page-head {
      border-bottom: 1px solid var(--line);
      padding-top: clamp(28px, 4.5vh, 48px);
      padding-bottom: clamp(32px, 5vh, 56px);
    }
    .page-head .tag { display: block; margin-top: clamp(28px, 5vh, 52px); }
    .page-head h1 {
      font-size: clamp(1.8rem, 3.4vw, 2.9rem);
      font-weight: 500; line-height: 1.1; letter-spacing: -.03em;
      margin-top: 16px; max-width: 26ch;
    }
    .standfirst {
      margin-top: 18px;
      font-size: 16.5px; color: var(--ink-2);
      max-width: 58ch; line-height: 1.6;
    }
    .byline {
      margin-top: 24px;
      font-family: var(--mono); font-size: 11px; font-weight: 500;
      letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2);
    }
    .byline a { color: var(--ink); transition: color .22s var(--ease); }
    .byline a:hover { color: var(--green); }

    /* ---------- layout ---------- */
    .article-layout {
      display: grid;
      grid-template-columns: minmax(0, 7.5fr) minmax(0, 4.5fr);
      gap: clamp(28px, 4vw, 72px);
      padding-block: clamp(36px, 5.5vh, 64px) clamp(48px, 7vh, 80px);
    }

    /* source box */
    .src-box {
      margin-top: 44px;
      max-width: 68ch;
      border: 1px solid var(--line);
      background: var(--green-tint);
      padding: 22px 24px;
    }
    .src-box .tag { display: block; margin-bottom: 12px; }
    .src-link {
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 15px; font-weight: 500; letter-spacing: -.005em;
      transition: color .22s var(--ease);
    }
    .src-link .arr { transition: transform .22s var(--ease); }
    .src-link:hover { color: var(--green); }
    .src-link:hover .arr { transform: translateX(4px); }

    /* related */
    .related { margin-top: clamp(40px, 6vh, 56px); max-width: 68ch; }
    .related .tag { display: block; margin-bottom: 6px; }
    .rel-list { list-style: none; }
    .rel-list li { border-bottom: 1px solid var(--line); }
    .rel-list li:first-child { border-top: 1px solid var(--line); }
    .rel-row {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 16px; align-items: baseline;
      padding: 14px 8px;
      transition: background-color .22s var(--ease);
    }
    .rel-row:hover { background: var(--green-tint); }
    .rel-cat {
      font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em;
      text-transform: uppercase; color: var(--green);
    }
    .rel-title { font-size: 15.5px; font-weight: 500; letter-spacing: -.005em; transition: color .18s var(--ease); }
    .rel-row:hover .rel-title { color: var(--green); }
    .rel-desc { display: block; margin-top: 4px; font-size: 13.5px; color: var(--ink-2); line-height: 1.5; }
    @media (max-width: 640px) {
      .rel-row { grid-template-columns: minmax(0, 1fr); }
    }

    .curated {
      margin-top: clamp(36px, 5vh, 48px);
      font-family: var(--mono); font-size: 11px; letter-spacing: .08em;
      text-transform: uppercase; color: var(--ink-3);
    }

    /* ---------- sidebar ---------- */
    .side {
      border-left: 1px solid var(--line);
      padding-left: clamp(24px, 3vw, 48px);
      align-self: stretch;
    }
    .side-sticky { position: sticky; top: 104px; }
    .side-block + .side-block {
      margin-top: clamp(30px, 4.5vh, 44px);
      padding-top: clamp(26px, 4vh, 38px);
      border-top: 1px solid var(--line);
    }
    .side-block .tag { display: block; margin-bottom: 16px; }
    .side-text { font-size: 14px; color: var(--ink-2); line-height: 1.6; max-width: 38ch; }
    .rss-link, .back-link {
      display: inline-flex; align-items: center; gap: 8px;
      margin-top: 16px;
      font-family: var(--mono); font-size: 11px; font-weight: 500;
      letter-spacing: .12em; text-transform: uppercase; color: var(--ink);
      transition: color .22s var(--ease);
    }
    .rss-link .arr, .back-link .arr { transition: transform .22s var(--ease); }
    .rss-link:hover, .back-link:hover { color: var(--green); }
    .rss-link:hover .arr { transform: translateX(4px); }
    .back-link { margin-top: 0; }
    .back-link:hover .arr { transform: translateX(-4px); }
    .b-list { list-style: none; }
    .b-list li { border-bottom: 1px solid var(--line); }
    .b-list li:first-child { border-top: 1px solid var(--line); }
    .b-row {
      display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
      padding: 11px 0;
    }
    .b-row .b-name { font-size: 14.5px; font-weight: 500; transition: color .18s var(--ease); }
    .b-row:hover .b-name { color: var(--green); }
    .b-row .b-count { font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); letter-spacing: .06em; }

    @media (max-width: 900px) {
      .article-layout { grid-template-columns: minmax(0, 1fr); }
      .side { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: clamp(28px, 4vh, 40px); }
      .side-sticky { position: static; }
    }
  </style>

  <style is:global>
    /* Markdown-rendered news body (wikilinks arrive as plain <a>) */
    .news-body { max-width: 68ch; }
    .news-body p { font-size: 16.5px; line-height: 1.7; color: var(--ink); }
    .news-body p + p { margin-top: 1.25em; }
    .news-body strong { font-weight: 600; }
    .news-body em { font-style: italic; }
    .news-body a {
      color: var(--green);
      border-bottom: 1px solid rgba(30, 77, 58, .35);
      transition: border-color .18s var(--ease);
    }
    .news-body a:hover { border-color: var(--green); }
  </style>
</BaseLayout>
