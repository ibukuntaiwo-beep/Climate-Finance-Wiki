---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ibukun Taiwo",
  "url": "https://climatefinancewiki.org/author/ibukun-taiwo/",
  "jobTitle": "Communications Professional",
  "description": "Creator and editor of the Climate Finance Wiki, a curated reference for communications professionals navigating climate finance.",
  "sameAs": [
    "https://www.linkedin.com/in/ibukuntaiwo",
    "https://github.com/ibukuntaiwo-beep"
  ],
  "mainEntityOfPage": {
    "@type": "WebSite",
    "name": "Climate Finance Wiki",
    "url": "https://climatefinancewiki.org"
  }
};
---
<BaseLayout title="Ibukun Taiwo | Climate Finance Wiki" description="Ibukun Taiwo is the creator and editor of the Climate Finance Wiki, a curated reference for communications professionals." footerType="internal">

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <nav class="crumbs pad" aria-label="Breadcrumb">
    <a href={url('/')}>Home</a>
    <span class="sep">&rarr;</span>
    <span class="here">Author</span>
  </nav>

  <div class="art-head pad">
    <p class="tag"><span class="num">Author</span>&ensp;/&ensp;The Curator</p>
    <h1>Ibukun Taiwo</h1>
    <p class="art-sub">Communications professional specialising in climate finance</p>
  </div>

  <main class="author-body pad">

    <section>
      <h2>About</h2>
      <p>Ibukun Taiwo is the creator and editor of the Climate Finance Wiki: a curated, editorially maintained reference that makes the language, instruments, institutions, and case studies of climate finance accessible to communications professionals.</p>
      <p>The wiki currently contains 52 articles across five categories, with over 240 cross-connections and three guided reading trails. Every article is written to the same standard: clear enough for a non-specialist, rigorous enough for a professional.</p>
      <p>The project draws on coursework from the CFA Institute Climate Finance Certificate, ICMA Green Bond Principles, UNFCCC reports, SEC enforcement filings, EU Taxonomy documentation, IPCC Assessment Reports, and academic and financial press reporting.</p>
    </section>

    <section>
      <h2>Connect</h2>
      <ul class="connect-list">
        <li>
          <a class="connect-row" href="https://www.linkedin.com/in/ibukuntaiwo" target="_blank" rel="noopener">
            <span class="connect-label">LinkedIn</span>
            <span class="connect-url">linkedin.com/in/ibukuntaiwo</span>
            <span class="connect-arr">&rarr;</span>
          </a>
        </li>
        <li>
          <a class="connect-row" href="https://github.com/ibukuntaiwo-beep" target="_blank" rel="noopener">
            <span class="connect-label">GitHub</span>
            <span class="connect-url">github.com/ibukuntaiwo-beep</span>
            <span class="connect-arr">&rarr;</span>
          </a>
        </li>
      </ul>
    </section>

    <section>
      <h2>Publication</h2>
      <p>The Climate Finance Wiki is a <strong>Red Barrow</strong> publication.</p>
    </section>

  </main>

</BaseLayout>

<style>
.crumbs {
  padding-top: 26px;
  font-family: var(--mono); font-size: 11px; font-weight: 500;
  letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2);
  display: flex; flex-wrap: wrap; gap: 6px 10px;
}
.crumbs a { transition: color .22s var(--ease); }
.crumbs a:hover { color: var(--green); }
.crumbs .sep { color: var(--ink-3); }
.crumbs .here { color: var(--ink); }

.art-head {
  padding-top: clamp(28px, 4.5vh, 48px);
  padding-bottom: clamp(28px, 4.5vh, 44px);
  border-bottom: 1px solid var(--line);
}
.art-head h1 {
  font-size: clamp(2.2rem, 4.5vw, 3.6rem);
  font-weight: 500; line-height: 1.04; letter-spacing: -.03em;
  margin-top: 16px;
}
.art-sub {
  margin-top: 18px;
  font-size: 17px; line-height: 1.6; color: var(--ink-2);
  max-width: 62ch;
}

.author-body {
  max-width: 820px;
  padding-block: clamp(36px, 6vh, 64px) clamp(48px, 7vh, 88px);
  font-size: 17px; line-height: 1.7;
}
.author-body p { margin-bottom: 19px; color: rgba(22, 22, 22, .82); max-width: 68ch; }
.author-body h2 {
  font-size: clamp(1.35rem, 2.2vw, 1.7rem);
  font-weight: 500; letter-spacing: -.02em; line-height: 1.2;
  margin: 46px 0 18px;
}
.author-body section:first-child h2 { margin-top: 0; }

.connect-list { list-style: none; }
.connect-list li { border-top: 1px solid var(--line); }
.connect-list li:last-child { border-bottom: 1px solid var(--line); }
.connect-row {
  display: grid;
  grid-template-columns: 110px minmax(0, 1fr) auto;
  gap: 16px; align-items: baseline;
  padding: 15px 8px;
  transition: background-color .22s var(--ease);
}
.connect-row:hover { background: var(--green-tint); }
.connect-label {
  font-family: var(--mono); font-size: 10.5px; font-weight: 500;
  letter-spacing: .12em; text-transform: uppercase; color: var(--green);
}
.connect-url { font-size: 15px; font-weight: 500; letter-spacing: -.005em; overflow-wrap: break-word; }
.connect-arr { color: var(--ink); transition: transform .22s var(--ease), color .22s var(--ease); }
.connect-row:hover .connect-arr { transform: translateX(4px); color: var(--green); }

@media (max-width: 900px) {
  .connect-row { grid-template-columns: minmax(0, 1fr) auto; row-gap: 4px; }
  .connect-label { grid-column: 1; }
  .connect-url { grid-column: 1; }
  .connect-arr { grid-row: 1; grid-column: 2; }
}
</style>
