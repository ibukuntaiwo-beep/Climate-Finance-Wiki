---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const steps = [
  {
    category: "Case Study",
    title: "PG&E Bankruptcy",
    href: url('/case-studies/pge-bankruptcy/'),
    note: "A utility worth $30 billion went bankrupt because of wildfires. Start here to understand why climate change is now a financial crisis, not just an environmental one."
  },
  {
    category: "Concept",
    title: "Climate Finance",
    href: url('/concepts/climate-finance/'),
    note: "What is this field, and why does money matter in the climate story? The foundation everything else builds on."
  },
  {
    category: "Concept",
    title: "The 1.5°C Threshold",
    href: url('/concepts/the-1.5c-threshold/'),
    note: "The number that defines the stakes. Understanding why every decimal point matters changes how you read every story that follows."
  },
  {
    category: "Concept",
    title: "Physical Risks",
    href: url('/concepts/physical-risks/'),
    note: "The first way climate threatens financial assets: direct physical damage from extreme weather, flooding, and a changing climate."
  },
  {
    category: "Concept",
    title: "Transition Risks",
    href: url('/concepts/transition-risks/'),
    note: "The second way: policy changes, technology shifts, and market pressure make entire asset classes uneconomic almost overnight."
  },
  {
    category: "Actor",
    title: "Mark Carney and the Tragedy of the Horizon",
    href: url('/actors/mark-carney/'),
    note: "The 2015 speech that moved climate risk from an environmental concern to a mainstream financial obligation."
  },
  {
    category: "Case Study",
    title: "HSBC Greenwashing",
    href: url('/case-studies/hsbc-greenwashing/'),
    note: "How a major bank responded to climate pressure with a poster campaign — and got banned by the advertising regulator for it."
  },
  {
    category: "Concept",
    title: "Greenwashing",
    href: url('/concepts/greenwashing/'),
    note: "What it is, why it proliferated, and why it is now regulated across advertising, investment products, and corporate disclosure."
  },
  {
    category: "Framework",
    title: "TCFD",
    href: url('/frameworks/tcfd/'),
    note: "The framework that made climate disclosure mainstream, and the template for almost every disclosure standard that followed."
  },
  {
    category: "Case Study",
    title: "Engine No. 1 vs ExxonMobil",
    href: url('/case-studies/engine-no-1-exxonmobil/'),
    note: "How a $40 million stake took on the world's largest oil company — and won three board seats by persuading the institutions that couldn't sell."
  },
  {
    category: "Case Study",
    title: "Seychelles Blue Bond",
    href: url('/case-studies/seychelles-blue-bond/'),
    note: "What good climate finance looks like in practice: a small island state pioneering an instrument the world is still learning from."
  }
];

const nextPaths = [
  {
    name: "The Greenwashing Trail",
    tagline: "From misleading claims to criminal charges.",
    href: url('/concepts/greenwashing/')
  },
  {
    name: "Follow the Money",
    tagline: "How climate finance actually flows, and where it gets stuck.",
    href: url('/concepts/climate-finance/')
  },
  {
    name: "Architecture of Climate Policy",
    tagline: "The agreements, taxonomies, and standards that set the rules.",
    href: url('/frameworks/paris-agreement/')
  }
];
---
<BaseLayout title="Start Here | Climate Finance Wiki" footerType="internal">
<main>

  <section class="path-head pad" aria-labelledby="path-h">
    <p class="tag"><span class="num">Editor&rsquo;s Recommended Path</span></p>
    <h1 id="path-h">New to climate finance? <em>Start here.</em></h1>
    <p class="path-intro">A curated path through the cases, concepts, and turning points that explain how climate became the defining financial story of our time. Eleven articles, no prior knowledge needed.</p>
  </section>

  <section class="steps-sec" aria-label="Recommended reading order">
    <div class="pad">
      <div class="sec-head">
        <p class="tag"><span class="num">01</span>&ensp;/&ensp;The Path</p>
        <p class="tag">{steps.length} ARTICLES</p>
      </div>
      <ol class="step-list">
        {steps.map((step, i) => (
          <li class="step-item reveal">
            <a class="step" href={step.href}>
              <span class="s-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="s-main">
                <span class="s-kind">{step.category}</span>
                <span class="s-title">{step.title}</span>
                <span class="s-blurb">{step.note}</span>
              </span>
              <span class="s-arr" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="trails-sec" aria-labelledby="next-h">
    <div class="pad">
      <div class="sec-head sec-head--tight">
        <p class="tag" id="next-h"><span class="num">02</span>&ensp;/&ensp;Where to Go Next</p>
      </div>
      <p class="next-intro">You now have the foundation. Pick a trail to go deeper.</p>
      <div class="trails-grid">
        {nextPaths.map((trail, i) => (
          <article class="trail reveal">
            <span class="t-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{trail.name}</h3>
            <p>{trail.tagline}</p>
            <span class="t-meta">6 ARTICLES&nbsp;&middot;&nbsp;~35 MIN</span>
            <a class="trail-link" href={trail.href}>Begin <span class="arr">&rarr;</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

</main>

<style>
/* ---------- path header ---------- */
.path-head {
  border-bottom: 1px solid var(--line);
  padding-top: clamp(36px, 6vh, 72px);
  padding-bottom: clamp(40px, 6vh, 72px);
}
.path-head h1 {
  font-size: clamp(2.5rem, 5.4vw, 4.6rem);
  font-weight: 500; line-height: 1.04; letter-spacing: -.035em;
  margin-top: 20px;
  max-width: 18ch;
}
.path-head h1 em { font-style: normal; color: var(--green); }
.path-intro {
  margin-top: 22px;
  font-size: 15.5px; color: var(--ink-2);
  max-width: 56ch;
}

/* ---------- steps ---------- */
.steps-sec { border-bottom: 1px solid var(--line); }
.step-list { list-style: none; padding-bottom: clamp(48px, 7vh, 80px); }
.step-item { border-top: 1px solid var(--line); }
.step-item:last-child { border-bottom: 1px solid var(--line); }
.step {
  display: grid;
  grid-template-columns: 64px minmax(0, 1fr) auto;
  gap: 16px; align-items: baseline;
  padding: clamp(18px, 2.6vh, 26px) 8px;
  transition: background-color .22s var(--ease);
}
.step .s-num {
  font-family: var(--mono); font-size: 12px; font-weight: 500; color: var(--green);
  transition: transform .22s var(--ease);
}
.step .s-kind {
  display: block;
  font-family: var(--mono); font-size: 10px; font-weight: 500;
  letter-spacing: .14em; text-transform: uppercase; color: var(--green);
  margin-bottom: 6px;
}
.step .s-title {
  display: block;
  font-size: clamp(1.25rem, 2.2vw, 1.7rem);
  font-weight: 500; letter-spacing: -.02em; line-height: 1.12;
}
.step .s-blurb {
  display: block;
  margin-top: 8px;
  font-size: 14px; color: var(--ink-2); line-height: 1.55;
  max-width: 66ch;
}
.step .s-arr {
  font-family: var(--mono); font-size: 13px; color: var(--ink-3);
  transition: transform .22s var(--ease), color .22s var(--ease);
}
.step:hover { background: var(--green-tint); }
.step:hover .s-num { transform: translateX(4px); }
.step:hover .s-arr { transform: translateX(4px); color: var(--green); }

/* ---------- trails (broadsheet columns) ---------- */
.trails-sec { border-bottom: 1px solid var(--line); }
.sec-head--tight { padding-bottom: clamp(16px, 2.5vh, 24px); }
.next-intro {
  font-size: 15.5px; color: var(--ink-2);
  max-width: 52ch;
  padding-bottom: clamp(24px, 4vh, 40px);
}
.trails-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding-bottom: clamp(48px, 7vh, 80px);
}
.trail {
  padding: 6px clamp(20px, 2.6vw, 36px) 8px;
  border-left: 1px solid var(--line);
  display: flex; flex-direction: column; align-items: flex-start;
}
.trail:first-child { border-left: 0; padding-left: 0; }
.trail:last-child { padding-right: 0; }
.trail .t-num {
  font-family: var(--mono); font-size: 12px; font-weight: 500;
  color: var(--green); margin-bottom: 16px;
}
.trail h3 {
  font-size: clamp(1.25rem, 1.9vw, 1.6rem);
  font-weight: 500; letter-spacing: -.015em; line-height: 1.15;
  margin-bottom: 10px;
}
.trail p { font-size: 14px; color: var(--ink-2); line-height: 1.6; margin-bottom: 18px; }
.trail .t-meta {
  font-family: var(--mono); font-size: 11px; color: var(--ink-3);
  letter-spacing: .06em; margin-bottom: 22px;
}
.trail-link {
  margin-top: auto;
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 11px; font-weight: 500;
  letter-spacing: .12em; text-transform: uppercase; color: var(--green);
}
.trail-link .arr { transition: transform .22s var(--ease); }
.trail-link:hover .arr { transform: translateX(4px); }
@media (max-width: 900px) {
  .trails-grid { grid-template-columns: minmax(0, 1fr); }
  .trail { border-left: 0; border-top: 1px solid var(--line); padding: 22px 0 28px; }
  .trail:first-child { border-top: 0; padding-top: 0; }
  .trail:last-child { padding-bottom: 0; }
}
</style>
</BaseLayout>
