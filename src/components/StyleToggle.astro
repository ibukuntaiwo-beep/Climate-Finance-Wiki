<div class="toggle-section">
  <div class="style-toggle">
    <button class="active" data-style="economist">Economist</button>
    <button data-style="nature">Nature</button>
  </div>
</div>

<script is:inline>
(function() {
  var buttons = document.querySelectorAll('.style-toggle button');
  buttons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var style = this.getAttribute('data-style');
      buttons.forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      document.querySelectorAll('.body-version').forEach(function(el) {
        el.classList.remove('active');
      });
      var target = document.querySelector('.body-version[data-style="' + style + '"]');
      if (target) target.classList.add('active');
    });
  });
})();
</script>

<style is:global>
.toggle-section{display:flex;justify-content:flex-end;margin:16px 0}
.style-toggle{display:inline-flex;border:1px solid var(--line)}
.style-toggle button{
  font-family:var(--mono);font-size:11px;font-weight:500;
  letter-spacing:.1em;text-transform:uppercase;
  padding:7px 14px;color:var(--ink-2);
  transition:background-color .22s var(--ease),color .22s var(--ease);
}
.style-toggle button + button{border-left:1px solid var(--line)}
.style-toggle button.active{background:var(--ink);color:var(--bg)}
.body-version{display:none}
.body-version.active{display:block}
</style>
