---
import { url } from '../lib/url';
interface Props {
  activePage?: 'topics' | 'news' | 'about';
}
const { activePage } = Astro.props;
---
<header class="site-head">
  <nav class="nav pad" aria-label="Primary">
    <a class="wordmark" href={url('/')}>
      Climate Finance Wiki
      <span class="mono-mark">EST. 2026</span>
    </a>
    <div class="nav-links">
      <a href={url('/#categories')} class={activePage === 'topics' ? 'nav-active' : ''}>Topics</a>
      <a href={url('/news/')} class={activePage === 'news' ? 'nav-active' : ''}>News</a>
      <a href={url('/about/')} class={activePage === 'about' ? 'nav-active' : ''}>About</a>
      <button class="nav-search" type="button" aria-label="Search the wiki" id="searchToggle">SEARCH</button>
    </div>
  </nav>
</header>
